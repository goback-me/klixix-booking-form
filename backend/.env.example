WEBHOOK_URL=
HENDRA_TOKEN=
WOOLLOONGABBA_TOKEN=
ALLOWED_ORIGIN=
PORT=
ZAPIER_WEBHOOK_URL=

# --- InfoAgent NEVDIS vehicle lookup (server-side only — never expose to the frontend) ---
# Selects BOTH the API host and which credential pair below is used.
#   test = api.dev.infoagent.com.au  (free sandbox, fake vehicles)
#   live = api.infoagent.com.au      (REAL CHARGES: ~$0.3072 + GST per lookup, "no match" billed too)
INFOAGENT_ENV=test

# Sandbox credentials
INFOAGENT_TEST_CLIENT_ID=
INFOAGENT_TEST_CLIENT_SECRET=

# Live credentials — only ever used when INFOAGENT_ENV=live. Set these in the
# hosting dashboard, never in a file that could be committed.
INFOAGENT_LIVE_CLIENT_ID=
INFOAGENT_LIVE_CLIENT_SECRET=

# --- Spend caps. InfoAgent has NO server-side cap; these are the only ceiling. ---
# Max billable lookups per Brisbane day before falling back to manual entry.
# Default 30, matching InfoAgent's daily warning email. Raise deliberately.
INFOAGENT_DAILY_LIMIT=30
# Optional hard ceiling per calendar month (blank = no monthly cap).
INFOAGENT_MONTHLY_LIMIT=
# Max distinct vehicle searches per visitor session (cached repeats are free). Default 5.
INFOAGENT_SESSION_LIMIT=5

# Signs the short-lived tokens that tie vehicle lookups to one booking session.
# Must be stable across restarts/instances or tokens stop validating.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOOKUP_SESSION_SECRET=

# --- Cloudflare Turnstile (bot challenge). REQUIRED when INFOAGENT_ENV=live. ---
# Secret key from the Turnstile dashboard. The matching site key goes in the
# frontend as VITE_TURNSTILE_SITE_KEY. Test-only keys that always pass:
#   secret 1x0000000000000000000000000000000AA / site key 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (durable counters + lookup cache). REQUIRED for live on Vercel. ---
# Without these, caps live in per-instance memory and cannot hold on serverless.
# Vercel's Storage → Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN
# instead; both name pairs are accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase: internal booking storage (server-side only — never expose the service key) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Internal admin page (HTTP Basic auth) at /admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=
