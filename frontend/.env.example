# Base URL of the booking API (no trailing slash)
VITE_API_URL=http://localhost:3001

# Cloudflare Turnstile site key (public). Leave blank to run without the bot
# challenge — only valid while the backend is in InfoAgent test mode.
# The site key's allowed hostnames must include every hostname the form is
# served from (the Vercel URL and embed.car-one.com.au), not the parent page.
VITE_TURNSTILE_SITE_KEY=
